{
  "name": "active-jitter-1k",
  "url": "http://127.0.0.1:8080/v1/chat/completions",
  "metrics_url": "http://127.0.0.1:6060/debug/metrics",
  "connections": 1000,
  "ramp_up": "30s",
  "duration": "2m",
  "request": {
    "model": "mock-chat-model",
    "prompt": "benchmark active jittered stream",
    "max_completion_tokens": 4096,
    "seed": 42,
    "include_usage": true
  },
  "server_env": {
    "PPROF_ADDR": "127.0.0.1:6060",
    "SSE_DELAY": "50ms",
    "SSE_DELAY_JITTER": "20ms",
    "SSE_INITIAL_DELAY": "0s",
    "SSE_TOKENS_PER_CHUNK": "1",
    "MAX_COMPLETION_TOKENS": "4096"
  }
}
